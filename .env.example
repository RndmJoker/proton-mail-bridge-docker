# Configuration for the Proton Mail Bridge container.
#
# Copy to .env and adjust. Every variable here is optional; the defaults are
# what the bridge itself uses, so a container started with none of them
# behaves like a bridge on a desktop.
#
# Your Proton credentials are NOT in this file and never will be. Signing in
# is interactive. A password in an environment variable ends up in the process
# list, in `docker inspect` and in every log that dumps the environment.

# ---------------------------------------------------------------------------
# Mail ports
# ---------------------------------------------------------------------------

# The ports IMAP and SMTP listen on, inside the container and outside it.
# The two are always the same number: the forward changes the address, not the
# port. Anything below 1024 is refused, because the container does not run as
# root and could not bind it.
BRIDGE_IMAP_PORT=1143
BRIDGE_SMTP_PORT=1025

# Direct TLS instead of STARTTLS. Both are encrypted; this only decides when
# the handshake happens. Off matches the bridge's own default, and it is what
# most mail clients expect from a local bridge.
BRIDGE_IMAP_SSL=false
BRIDGE_SMTP_SSL=false

# ---------------------------------------------------------------------------
# Sign-in page
# ---------------------------------------------------------------------------

# Where the sign-in page listens. It runs only while no account is signed in,
# and shuts down as soon as one is.
BRIDGE_SETUP_PORT=8443

# Whether the page is reachable from outside the container.
#
# Off by default, and think before turning it on: this page accepts your Proton
# password. With it off, the way to sign in is
#
#   docker exec -it proton-bridge proton-login
#
# With it on, the page also demands an access token, which is generated at
# every start and printed to the container log. Even then it belongs behind a
# tunnel or a VPN, never on the open internet.
BRIDGE_SETUP_EXPOSE=false

# ---------------------------------------------------------------------------
# Ports as published on the host
# ---------------------------------------------------------------------------

# What you published the mail ports as, so that proton-info can name the
# numbers a mail client actually needs.
#
# Nothing in the container binds these or checks them. They exist because the
# container cannot find them out: publishing a port happens outside it, and
# from inside there is no way to see which port it landed on. The only
# mechanism that would work is reading the container engine's socket, which
# means handing a container that holds a mailbox control of the engine, for a
# line of output.
#
# Leave them unset and proton-info says the ports it prints are the container's
# own, and shows the form to fill in. That is honest. Setting them is more
# convenient and equally honest, because the report says the numbers came from
# here rather than from a measurement.
#
# The obvious case: anyone already running Proton's desktop bridge, which holds
# 1143 and 1025 on the host, has to publish somewhere else.
#
#   docker run -p 127.0.0.1:11143:1143 -p 127.0.0.1:11025:1025 ...
#
# BRIDGE_PUBLIC_IMAP_PORT=11143
# BRIDGE_PUBLIC_SMTP_PORT=11025

# ---------------------------------------------------------------------------
# Bridge settings
# ---------------------------------------------------------------------------
# All three are applied at every start and read back afterwards. If the bridge
# does not keep one, the container stops rather than running in a state its log
# does not describe.

# Reach Proton over DNS-over-HTTPS and third-party infrastructure when the
# normal API is blocked. Off by default, as in the bridge itself.
#
# It changes who can see that a connection to Proton is being attempted, so it
# is not something to switch on for everyone by default. Turn it on if your
# network blocks Proton.
BRIDGE_ALTERNATIVE_ROUTING=false

# Whether usage diagnostics are reported to Proton.
#
# Off by default, and that is a decision rather than the bridge's default
# carried over. A container on a server has nobody to ask, and something that
# reports back about a mailbox should not start doing so because nobody said
# otherwise.
BRIDGE_TELEMETRY=false

# Whether the All Mail folder appears in your mail client.
#
# Deliberately unset by default, which means the bridge keeps whatever it has.
# Setting a value here would overwrite a choice made in Proton's own
# application the first time this container starts against an existing vault.
#
# Unlike the two above, this one is only touched when it is set: removing the
# line again leaves whatever is in the vault. The two above have a default and
# are enforced on every start, so removing one of those puts the default back.
#
# `proton-info` prints what currently applies, read from the bridge.
#
# BRIDGE_SHOW_ALL_MAIL=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# One of panic, fatal, error, warn, info, debug. Anything else is refused at
# startup rather than passed on to the bridge, which would exit with a less
# helpful message.
#
# debug is verbose but does not print mail contents or credentials.
BRIDGE_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Timeouts, in seconds
# ---------------------------------------------------------------------------

# How long to wait for the bridge's gRPC service after starting it. Generous
# on purpose: the first start on a fresh volume generates a GPG key and
# unlocks a new vault.
BRIDGE_START_TIMEOUT=120

# How long to wait for a mail port to open before giving up on forwarding it.
# Giving up is not fatal: the bridge keeps running, the port simply stays
# reachable from inside the container only, and the log says so.
BRIDGE_FORWARD_TIMEOUT=60

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Where the volume is mounted. Everything the bridge writes goes here: the
# vault, the keychain, and the GPG key that unlocks it.
#
# Changing this means changing the mount too. There is rarely a reason.
BRIDGE_HOME=/data
