# Build artefacts
/bridge-control
/proton-info
/dist/
*.exe

# Pinned tools fetched by scripts/generate-proto.sh
/.tools/

# Generated gRPC code. Deliberately not versioned, see proto/README.md. The
# directory itself is: internal/bridgepb/doc.go is written by hand and keeps
# the package resolvable before anything has been generated. A pattern for the
# directory with an exception for doc.go would not work, because git does not
# look inside a directory it ignores.
/internal/bridgepb/*.pb.go

# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Local container state (holds the keychain and decrypted mail)
data/
volume/

# Logs
*.log

# Editors and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Scratch space
scratch/
tmp/

# Local working material, kept out of the public repository
/.agents
/.claude
/AGENTS.md
/CLAUDE.md
